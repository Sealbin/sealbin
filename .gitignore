# Rust
/target

# The Worker bundle worker-build emits (crates/sealbin-worker/wrangler.toml ->
# `main = "build/worker/shim.mjs"`).
crates/sealbin-worker/build/

# The static assets the Worker serves: `web/build.sh` regenerates them and
# wrangler reads them from crates/sealbin-worker/wrangler.toml `[assets]`.
web/dist/

# Node / Wrangler / Wrangler dev secrets
node_modules/
.wrangler/
.dev.vars

# Credential files. Never commit these; several are read by tools from the
# working directory and would leak live keys.
.env
.env.*
!.env.example
.envrc
.git-credentials
.netrc
.npmrc
.pypirc
